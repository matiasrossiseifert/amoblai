# Copiar a .env y completar. .env nunca se commitea.

# OpenAI (lo provee la cátedra): generadores gpt-image.
OPENAI_API_KEY=

# Google Gemini (opcional): generadores de imagen de Gemini.
GEMINI_API_KEY=

# Hugging Face (opcional): necesario para DINOv3, que es gated.
HF_TOKEN=

# LangSmith (opcional): trazas de cada etapa del pipeline.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=amoblai
