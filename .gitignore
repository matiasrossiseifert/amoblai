# Secretos
.env
.env.*
!.env.example

# Dataset descargado, lo procesado desde él y cachés (descripciones, vectores, ChromaDB):
# se regeneran con la CLI
/datos/dataset/
/datos/procesados/
/datos/cache/

# Fotos del dataset IKEA dentro de las corridas: las copias que arma el generador manual y las
# hojas de candidatos (mosaicos de fotos del catálogo). No se commitean; el flujo las rehace.
/datos/resultados/amoblar/*/manual/[0-9]_product_*
/datos/resultados/amoblar/**/2_candidates*.jpg

# Documentación, consigna y material de la materia: solo local
/docs/
/material-clases/

# Python / herramientas
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Gradio
.gradio/
flagged/

# Editores / SO
.idea/
.vscode/
.DS_Store
*.swp

