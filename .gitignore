# Secretos
.env
.env.*
!.env.example

# Dataset descargado, lo procesado desde él y cachés (descripciones, vectores, ChromaDB):
# se regeneran con la CLI
/datos/dataset/
/datos/procesados/
/datos/cache/

# Fotos del dataset IKEA dentro de las corridas: las copias que arma el generador manual y las
# hojas de candidatos (mosaicos de fotos del catálogo). No se commitean; el flujo las rehace.
/datos/resultados/amoblar/*/manual/[0-9]_product_*
/datos/resultados/amoblar/**/2_candidates*.jpg
/datos/resultados/punta_a_punta/**/2_candidates*.jpg
# La copia de la foto del ambiente en cada variante (la original está en datos/ambientes_vacios/)
/datos/resultados/punta_a_punta/**/room.jpg
# Los recortes de la evaluación de la imagen (llevan la foto del catálogo al lado)
/datos/resultados/amoblar/**/6_recortes*.jpg
# La página de las corridas (amoblai corridas): apunta a fotos que git no tiene
/datos/resultados/amoblar/index.html

# Documentación, consigna y material de la materia: solo local
/docs/
/material-clases/

# Python / herramientas
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Gradio
.gradio/
flagged/

# Editores / SO
.idea/
.vscode/
.DS_Store
*.swp

# Temporales de escritura atómica
*.tmp

# Fotos públicas de ambientes vacíos: se bajan con `amoblai data ambientes` (publicas.yaml)
/datos/ambientes_vacios/publicas/
/datos/resultados/replica/**/real_con_cajas.jpg
