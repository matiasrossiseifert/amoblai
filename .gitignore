# Secretos
.env
.env.*
!.env.example

# datos/ va completo (dataset, procesados, caché de las respuestas pagadas, fotos, corridas)
# para que el equipo trabaje sin volver a bajar ni pagar nada. El repo es privado.

# Documentación, consigna y material de la materia: solo local. Excepción: la presentación
# (fuentes, guion, .html y las fuentes tipográficas recortadas); no las capturas de trabajo.
/docs/*
!/docs/presentacion/
!/docs/METRICAS.md
!/docs/EXPERIMENTOS.md
!/docs/FUTURO.md
!/docs/REVISION.md
/docs/presentacion/_trabajo/*
!/docs/presentacion/_trabajo/fuentes/
!/docs/presentacion/_trabajo/sift_*.json
!/docs/presentacion/_trabajo/vector_*.json
/material-clases/

# Python / herramientas
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Gradio
.gradio/
flagged/

# Editores / SO
.idea/
.vscode/
.DS_Store
*.swp

# Temporales de escritura atómica
*.tmp
